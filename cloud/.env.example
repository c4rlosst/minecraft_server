# Copy to .env (or run ./init.sh) and edit. .env is git-ignored: it holds secrets.

# You must accept the Minecraft EULA yourself: https://aka.ms/MinecraftEULA  -> set to TRUE
EULA=

# --- Server ---
SERVER_NAME=Our SMP
MC_VERSION=26.3
MC_IMAGE_TAG=java25
MC_MEMORY=6G
MAX_PLAYERS=10
# Modrinth slugs, comma separated. Server-only performance mods by default.
MODS=fabric-api,lithium,ferrite-core
# Your Minecraft name(s), comma separated, get operator rights
OPS=
# Shown in the panel and Discord (what friends type into Minecraft)
PUBLIC_ADDRESS=

# --- Sleep / wake ---
IDLE_MINUTES=10

# --- Secrets ---
RCON_PASSWORD=
PANEL_PASSWORD=

# --- Optional: Discord bot (leave empty to disable) ---
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Only members with this role can start/stop/whitelist (empty = everyone in the server)
DISCORD_ROLE_ID=

# --- Optional: playit.gg tunnel (compose profile "playit") ---
PLAYIT_SECRET_KEY=

# --- Optional: HTTPS for the panel (compose profile "https") ---
PANEL_DOMAIN=
# When using https, bind the panel to localhost only and let Caddy front it
PANEL_BIND=0.0.0.0
TRUST_PROXY=
